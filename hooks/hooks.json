{
  "description": "cc-soul hooks for persistent memory and realm-scoped recall",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subconscious.sh start",
            "timeout": 8,
            "statusMessage": "awakening\u2026"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start-hook.sh",
            "timeout": 10,
            "statusMessage": "recalling context\u2026"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/compact-restore-hook.sh",
            "timeout": 5,
            "statusMessage": "restoring context\u2026"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subconscious.sh start",
            "timeout": 8,
            "statusMessage": "awakening\u2026"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start-hook.sh",
            "timeout": 10,
            "statusMessage": "resuming\u2026"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/resume-inject-hook.sh",
            "timeout": 3,
            "statusMessage": "preparing recap\u2026"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subconscious.sh start",
            "timeout": 8,
            "statusMessage": "awakening\u2026"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start-hook.sh",
            "timeout": 10,
            "statusMessage": "recalling context\u2026"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/prompt-hook.sh",
            "timeout": 10,
            "statusMessage": "resonating\u2026"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.sh",
            "timeout": 30,
            "statusMessage": "preserving state\u2026"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-end-hook.sh",
            "timeout": 5,
            "statusMessage": "releasing session\u2026"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact-hook.sh",
            "statusMessage": "consolidating memory\u2026"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop-hook.sh",
            "timeout": 5,
            "statusMessage": "capturing learnings\u2026",
            "async": true
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/file-changed-hook.sh",
            "timeout": 15,
            "statusMessage": "re-indexing\u2026",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/pre-tool-hook.sh Bash",
            "timeout": 10,
            "statusMessage": "checking command patterns\u2026"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/pre-tool-hook.sh Read",
            "timeout": 10,
            "statusMessage": "checking read budget\u2026"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/pre-tool-hook.sh Grep",
            "timeout": 10,
            "statusMessage": "checking grep budget\u2026"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/pre-tool-hook.sh Glob",
            "timeout": 10,
            "statusMessage": "checking glob budget\u2026"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/pre-tool-hook.sh Edit",
            "timeout": 10,
            "statusMessage": "checking edit strategy\u2026"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/pre-tool-hook.sh Write",
            "timeout": 10,
            "statusMessage": "checking write strategy\u2026"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/pre-tool-hook.sh Agent",
            "timeout": 10,
            "statusMessage": "checking agent budget\u2026"
          }
        ]
      },
      {
        "matcher": "ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/pre-tool-hook.sh ScheduleWakeup",
            "timeout": 10,
            "statusMessage": "checking loop budget\u2026"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/log-bash-history.sh",
            "timeout": 5,
            "statusMessage": "logging command\u2026",
            "async": true
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-bash-hook.sh",
            "timeout": 5,
            "statusMessage": "checking result\u2026"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/memory-intercept.sh",
            "timeout": 10,
            "statusMessage": "syncing memory\u2026",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-bash-hook.sh"
          }
        ]
      }
    ]
  }
}